# Local stack configuration (T-010). Copy this file to deploy/.env, which is
# git-ignored, and replace every placeholder. Every variable is required:
# Compose stops with a message naming any that is missing or empty.
# Never commit real values.

# PostgreSQL superuser, its password, and the database created on first start.
# They take effect only when the pgdata volume is empty (first start).
POSTGRES_USER=boardgame
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=boardgame

# Server log level: debug, info, warning, or error. Production uses info.
LOG_LEVEL=info

# Optional, so commented out (the variables above are the required ones):
# the eBay marketplace account deletion endpoint (T-084). Set both or
# neither; with neither the endpoint is off. Rules in server/.env.example.
# EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=replace-me-replace-me-replace-me-replace-me
# EBAY_ACCOUNT_DELETION_ENDPOINT_URL=https://api.example.com/ebay/marketplace-account-deletion
