      ]
    },
    {
      "name": "barcode_matches",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"barcode_matches\" (\"gtin13\" TEXT NOT NULL CHECK(LENGTH(\"gtin13\") = 13 AND (gtin13 NOT GLOB '*[^0-9]*')), \"game_id\" INTEGER NOT NULL REFERENCES games (id), \"confirmed_at\" INTEGER NOT NULL, PRIMARY KEY (\"gtin13\"));"
        }
      ]
    },
