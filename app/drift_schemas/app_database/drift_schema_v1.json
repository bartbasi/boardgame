      "name": "games",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"games\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"bgg_id\" INTEGER NULL CHECK(bgg_id > 0) UNIQUE, \"details_json\" TEXT NULL, \"fetched_at\" INTEGER NULL, \"last_viewed_at\" INTEGER NULL);"
