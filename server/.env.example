# Server configuration. Copy this file to server/.env (git-ignored) and adjust.
# Variables marked "required" must be set; the server exits at startup (code
# 78) if one is missing or invalid, naming the variable but never its value.
# Values here are placeholders, never real secrets.

# Required. TCP port the HTTP server listens on: an integer from 1 to 65535.
PORT=8080

# Required. Minimum log level: debug, info, warning, or error.
LOG_LEVEL=info

# PostgreSQL (T-019). In Compose these come from deploy/.env.
# Required. Host name or IP address of the PostgreSQL server.
DATABASE_HOST=localhost

# Optional, default 5432.
DATABASE_PORT=5432

# Required. Database name and login role (at most 63 bytes each).
DATABASE_NAME=boardgame
DATABASE_USER=boardgame

# Required. Password of DATABASE_USER. Never logged or printed.
DATABASE_PASSWORD=replace-with-a-long-random-password

# Optional, default 5 [ASSUMPTION]. Maximum open connections in the pool,
# from 1 to 20.
DATABASE_POOL_MAX=5
