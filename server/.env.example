# Server configuration. Copy this file to server/.env (git-ignored) and adjust.
# Variables marked "required" must be set; the server exits at startup (code
# 78) if one is missing or invalid, naming the variable but never its value.
# Values here are placeholders, never real secrets.

# Required. TCP port the HTTP server listens on: an integer from 1 to 65535.
PORT=8080

# Required. Minimum log level: debug, info, warning, or error.
LOG_LEVEL=info

# PostgreSQL (T-019). In Compose these come from deploy/.env.
# Required. Host name or IP address of the PostgreSQL server.
DATABASE_HOST=localhost

# Optional, default 5432.
DATABASE_PORT=5432

# Required. Database name and login role (at most 63 bytes each).
DATABASE_NAME=boardgame
DATABASE_USER=boardgame

# Required. Password of DATABASE_USER. Never logged or printed.
DATABASE_PASSWORD=replace-with-a-long-random-password

# Optional, default 5 [ASSUMPTION]. Maximum open connections in the pool,
# from 1 to 20.
DATABASE_POOL_MAX=5

# Per-IP rate limiting on /v1 (T-020). /health is never limited.
# Optional, default 60 [ASSUMPTION]. Requests allowed per client IP per
# minute, from 1 to 10000.
RATE_LIMIT_PER_MINUTE=60

# Optional, default 100000 [ASSUMPTION]. Most client IPs tracked at once, from
# 1 to 200000; when full, the oldest entry is evicted. About 5 MB at 100000.
RATE_LIMIT_MAX_TRACKED_IPS=100000

# Optional, default none. Comma-separated IP addresses of the reverse proxy
# whose X-Forwarded-For header is trusted for the client IP. In Compose this
# is Caddy's fixed address on the `web` network (deploy/docker-compose.yml).
# Requests from any other peer are limited by their socket address, and their
# X-Forwarded-For is ignored. Leave it out when running without Caddy.
TRUSTED_PROXY_ADDRESSES=10.213.7.10

# Optional, so the two lines below are commented out: copying this file
# unchanged leaves the endpoint off. eBay marketplace account deletion
# endpoint (T-084), served at /ebay/marketplace-account-deletion outside /v1
# (no app attestation, its own limit of 300 requests per IP per minute
# [ASSUMPTION]). Set both or neither; with neither the endpoint is off (404). eBay requires it before the first production
# eBay API call (docs/api-research.md EBAY-10, EBAY-11).
# The verification token entered in the eBay developer portal: 32 to 80
# letters, digits, underscores, or hyphens. A secret: never logged or printed.
# EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=replace-me-replace-me-replace-me-replace-me

# The endpoint URL exactly as entered in the eBay developer portal; it is
# hashed into the challenge response as written. It must be https with a
# public host name or IP (no localhost, no internal address), the path
# /ebay/marketplace-account-deletion, and no query or fragment.
# EBAY_ACCOUNT_DELETION_ENDPOINT_URL=https://api.example.com/ebay/marketplace-account-deletion
