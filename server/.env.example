# Server configuration. Copy this file to server/.env (git-ignored) and adjust.
# Every variable below is required; the server exits at startup if one is
# missing or invalid. Values here are placeholders, never real secrets.

# TCP port the HTTP server listens on: an integer from 1 to 65535.
PORT=8080

# Minimum log level: debug, info, warning, or error.
LOG_LEVEL=info
